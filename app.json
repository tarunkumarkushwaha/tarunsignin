{
  "expo": {
    "name": "tarunsignin",
    "slug": "tarunsignin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Q.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Q.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tarun_kumar_kushwaha.tarunsignin"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Q.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4af0907c-4d5b-4ade-9f80-aeef33bad874"
      }
    }
  }
}
